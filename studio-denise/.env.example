# ─────────────────────────────────────────────────────────────
# Clube Studio Denise de Paula — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA versione o arquivo `.env`.
# ─────────────────────────────────────────────────────────────

# Banco de dados
# Demonstração local (padrão): SQLite.
DATABASE_URL="file:./dev.db"
# Produção (recomendado): PostgreSQL — troque também o `provider` em
# prisma/schema.prisma para "postgresql".
# DATABASE_URL="postgresql://user:pass@host:5432/clube?schema=public"

# Sessão / autenticação (troque por um segredo forte de 32+ caracteres)
AUTH_SECRET="troque-por-um-segredo-bem-longo-e-aleatorio-please"

# URL pública do site (usada em webhooks e metadados)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Gateway de pagamento (Mercado Pago) ──────────────────────
# Deixe em branco para rodar em MODO SIMULAÇÃO (pagamento aprovado
# automaticamente para demonstração). Ao preencher, o app usa o
# Mercado Pago de verdade (sandbox ou produção conforme o token).
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# ── Notificações (integração futura) ─────────────────────────
# WHATSAPP_API_TOKEN=""
# EMAIL_SMTP_URL=""
