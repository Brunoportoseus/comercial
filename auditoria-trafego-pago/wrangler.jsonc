{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auditoria-trafego-pago",
  "compatibility_date": "2026-06-09",
  "main": "./_worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Domínios próprios. Canônico: www.diagnosticotrafegopago.com.br.
  // O apex do novo domínio e o domínio antigo (auditoria*) redirecionam 301
  // para o canônico via _worker.js. Requer as zonas ATIVAS na Cloudflare — se
  // o `wrangler deploy` falhar ao criar algum custom domain (zona ainda não
  // ativa), adicione-o pelo painel (Workers > Settings > Domains & Routes).
  "routes": [
    { "pattern": "diagnosticotrafegopago.com.br", "custom_domain": true },
    { "pattern": "www.diagnosticotrafegopago.com.br", "custom_domain": true },
    { "pattern": "auditoriatrafegopago.com.br", "custom_domain": true },
    { "pattern": "www.auditoriatrafegopago.com.br", "custom_domain": true }
  ]
}
