{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conecta-consorcios",
  "compatibility_date": "2026-06-09",
  "main": "./_worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Domínio próprio (conectaconsorcioservopa.com.br).
  // Usamos Workers Routes (pattern + zone_name) em vez de custom_domain:
  // as rotas aproveitam os registros DNS "proxied" que já existem na zona
  // (o domínio foi migrado do Wix), então o Worker assume o tráfego sem
  // precisar criar/alterar DNS e sem o conflito code: 100117.
  // O redirect de www -> apex é feito em _worker.js.
  "routes": [
    { "pattern": "conectaconsorcioservopa.com.br/*", "zone_name": "conectaconsorcioservopa.com.br" },
    { "pattern": "www.conectaconsorcioservopa.com.br/*", "zone_name": "conectaconsorcioservopa.com.br" }
  ]
  // Variáveis de ambiente / secrets do destino de leads (configurar no painel
  // Cloudflare ou via `wrangler secret put`). NUNCA colocar valores aqui:
  //   LEAD_WEBHOOK_URL   — URL genérica (POST JSON)
  //   KOMMO_WEBHOOK_URL  — webhook de entrada do Kommo
  //   LEAD_EMAIL_TO      — e-mail de destino (requer RESEND_API_KEY)
  //   LEAD_EMAIL_FROM    — remetente verificado no Resend
  //   RESEND_API_KEY     — secret da API Resend
  //   TURNSTILE_SECRET   — secret do Cloudflare Turnstile (opcional)
}
