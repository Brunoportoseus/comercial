# Copie para .env e preencha. NUNCA faça commit do .env nem da chave JSON.

# ID numérico da propriedade GA4 (GA4 > Administrador > Detalhes da propriedade)
GA4_PROPERTY_ID=

# Propriedade do Search Console (propriedade de Domínio)
GSC_SITE_URL=sc-domain:terrenoscuritibaeregiao.com.br

# Só para o modo HTTP (claude.ai). Gere com: openssl rand -hex 24
MCP_SECRET_PATH=

# Só para o Cloudflare Tunnel (Zero Trust > Networks > Tunnels > token do túnel)
CLOUDFLARE_TUNNEL_TOKEN=
